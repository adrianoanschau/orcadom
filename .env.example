# ---- Docker / Postgres ----
POSTGRES_USER=orcadom
POSTGRES_PASSWORD=orcadom_dev_password
POSTGRES_DB=orcadom_db
POSTGRES_PORT=5432

# ---- Usada pelo Prisma (packages/database) e pela API (apps/api) ----
DATABASE_URL="postgresql://orcadom:orcadom_dev_password@localhost:5432/orcadom_db?schema=public"

# ---- API (apps/api) ----
PORT=8080
# info em produção, debug em desenvolvimento. Override explícito:
LOG_LEVEL=info

# ---- Observabilidade (profile Docker `observability`) ----
# DSN do projeto no GlitchTip (http://localhost:8000). Vazio = SDK desligado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
GLITCHTIP_SECRET_KEY=troque_este_valor
GLITCHTIP_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Backup Postgres (profile Docker `backup`) ----
# MinIO local emula S3. Em produção, aponte para AWS S3 / B2 e deixe
# BACKUP_S3_ENDPOINT vazio (API da AWS) ou com o endpoint S3-compatível.
BACKUP_S3_ENDPOINT=http://minio:9000
BACKUP_S3_BUCKET=orcadom-backups
BACKUP_S3_ACCESS_KEY=orcadom_backup
BACKUP_S3_SECRET_KEY=orcadom_backup_dev
BACKUP_S3_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKUP_METRICS_PORT=9105
# Vazio = o container gera um par age no volume orcadom_backup_keys (só local).
# Em qualquer dado real: age-keygen e preencha os dois valores.
BACKUP_AGE_PUBLIC_KEY=
BACKUP_AGE_SECRET_KEY=
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_CRON=0 3 * * *
BACKUP_RESTORE_TEST_CRON=0 4 1 * *
BACKUP_RUN_ON_START=true
BACKUP_RESTORE_TEST_ON_START=false

# ---- Auth (apps/api) ----
JWT_ACCESS_SECRET=troque_este_valor_em_producao
JWT_REFRESH_SECRET=troque_este_outro_valor_em_producao
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=12h
JWT_REFRESH_REMEMBER_EXPIRATION=30d
# Cookies Secure. Em produção o default é true; local/E2E em HTTP use false.
# COOKIE_SECURE=false
# Desliga @Cron (útil em E2E). Omitido = crons ativos.
# CRON_DISABLED=true

# Relatórios PDF/XLSX (fora do volume do Postgres). Default: data/reports
REPORTS_DIR=data/reports

# ---- Frontend (apps/web) ----
# O navegador chama a própria origem; o Next encaminha para a API e o cookie fica visível ao proxy.
API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_API_URL=/backend
# Origem liberada no CORS da API. Em deploy, o domínio público do web.
WEB_ORIGIN=http://localhost:3000

# ---- n8n / importação por email ----
N8N_PORT=5678
# Não injete N8N_ENCRYPTION_KEY no compose se o volume do n8n já existe —
# a chave persistida em /home/node/.n8n/config é a que vale.
N8N_WEBHOOK_URL=http://localhost:5678/

# Chave compartilhada entre o workflow do n8n e a API.
AUTOMATION_API_KEY=troque_este_valor_em_producao

# Caixa única de encaminhamento. O alias do usuário vira local+token@domínio.
IMPORT_EMAIL_MAILBOX=importacoes@orcadom.app

# ---- n8n / notificações por email ----
# A API chama o webhook; o n8n envia o email. Sem esses valores, o aviso
# in-app continua funcionando e o canal de email é só ignorado.
NOTIFICATIONS_WEBHOOK_URL=http://localhost:5678/webhook/send-notification
NOTIFICATIONS_WEBHOOK_SECRET=troque_este_valor_em_producao

# ---- Web Push (PWA) ----
# Sem essas chaves, o canal WEB_PUSH é ignorado (in-app continua).
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=troque_este_valor_em_producao
VAPID_PRIVATE_KEY=troque_este_valor_em_producao
VAPID_SUBJECT=mailto:orcadom@localhost
