# ---- Docker / Postgres ----
POSTGRES_USER=orcadom
POSTGRES_PASSWORD=orcadom_dev_password
POSTGRES_DB=orcadom_db
POSTGRES_PORT=5432

# ---- Usada pelo Prisma (packages/database) e pela API (apps/api) ----
DATABASE_URL="postgresql://orcadom:orcadom_dev_password@localhost:5432/orcadom_db?schema=public"

# ---- API (apps/api) ----
PORT=8080

# ---- Auth (apps/api) ----
JWT_ACCESS_SECRET=troque_este_valor_em_producao
JWT_REFRESH_SECRET=troque_este_outro_valor_em_producao
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ---- Frontend (apps/web) ----
# O navegador chama a própria origem; o Next encaminha para a API e o cookie fica visível ao proxy.
API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_API_URL=/backend

# ---- n8n / importação por email ----
N8N_PORT=5678
# Não injete N8N_ENCRYPTION_KEY no compose se o volume do n8n já existe —
# a chave persistida em /home/node/.n8n/config é a que vale.
N8N_WEBHOOK_URL=http://localhost:5678/

# Chave compartilhada entre o workflow do n8n e a API.
AUTOMATION_API_KEY=troque_este_valor_em_producao

# Caixa única de encaminhamento. O alias do usuário vira local+token@domínio.
IMPORT_EMAIL_MAILBOX=importacoes@orcadom.app

# ---- n8n / notificações por email ----
# A API chama o webhook; o n8n envia o email. Sem esses valores, o aviso
# in-app continua funcionando e o canal de email é só ignorado.
NOTIFICATIONS_WEBHOOK_URL=http://localhost:5678/webhook/send-notification
NOTIFICATIONS_WEBHOOK_SECRET=troque_este_valor_em_producao
