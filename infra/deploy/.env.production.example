# =============================================================================
# .env.production.example — PRODUÇÃO do Orcadom no VPS (Hostinger KVM 1)
# Copie para /opt/orcadom/.env  (chmod 600). NUNCA commite o .env real.
# Caminho no repositório: infra/deploy/.env.production.example
#
# Gere cada segredo com o comando indicado. Use sempre `openssl rand -hex`
# (só [0-9a-f]) para senhas que entram em URL (DATABASE_URL) — sem escapes.
#
# IMAGE_TAG NÃO fica aqui: o deploy-prod.sh grava a tag em uso em
# /opt/orcadom/.env.image (e a anterior em .env.image.prev).
# =============================================================================

# ---- Imagens (GHCR) ----
GHCR_IMAGE_PREFIX=ghcr.io/adrianoanschau/orcadom

# ---- Hosts públicos (Caddy) ----
ACME_EMAIL=seu-email@exemplo.com
PROD_WEB_HOST=orcadom.aanschau.tech
PROD_API_HOST=api.orcadom.aanschau.tech
N8N_HOST=n8n.aanschau.tech

# ---- Previews de PR ----
PREVIEW_BASE_DOMAIN=orcadom.aanschau.tech
PREVIEW_MAX=2
# Roda o seed sintético (seed-staging) quando o banco do preview é criado.
PREVIEW_SEED=true
PREVIEWS_DIR=/opt/orcadom/previews

# ---- Postgres (profile deps, container orcadom-postgres) ----
POSTGRES_USER=orcadom
# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=orcadom_db
# Mesma senha acima; host = serviço `postgres` na rede interna.
DATABASE_URL=postgresql://orcadom:CHANGE_ME@postgres:5432/orcadom_db?schema=public

# ---- Auth (apps/api) ----
# openssl rand -hex 32   (um valor diferente para cada)
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=12h
JWT_REFRESH_REMEMBER_EXPIRATION=30d

# ---- API / Web ----
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Origem do web (CORS da API). O navegador usa o BFF /backend do próprio web.
WEB_ORIGIN=https://orcadom.aanschau.tech
# O web fala com a API pela rede interna do Docker.
API_URL=http://api:8080
NEXT_PUBLIC_API_URL=/backend
REPORTS_DIR=/app/data/reports
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_LOGIN_LIMIT=5
THROTTLE_AUTOMATION_LIMIT=60

# ---- n8n ----
# Fixe a versão (veja a tag em https://hub.docker.com/r/n8nio/n8n/tags).
N8N_VERSION=latest
N8N_WEBHOOK_URL=https://n8n.aanschau.tech/
# openssl rand -hex 32  — compartilhada entre workflow do n8n e API
AUTOMATION_API_KEY=CHANGE_ME
# A API chama o n8n pela rede interna (sem sair pela internet).
NOTIFICATIONS_WEBHOOK_URL=http://n8n:5678/webhook/send-notification
# openssl rand -hex 32
NOTIFICATIONS_WEBHOOK_SECRET=CHANGE_ME
IMPORT_EMAIL_MAILBOX=importacoes@orcadom.app

# ---- Web Push (PWA) ----
# docker run --rm node:20-alpine npx -y web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# ---- Backup (profile backup -> Backblaze B2) — AINDA NÃO ATIVO ----
# Preencha quando o backup for ligado (ver docs/27-backup-postgres.md).
# BACKUP_S3_ENDPOINT=https://s3.<regiao>.backblazeb2.com
# BACKUP_S3_BUCKET=orcadom-backups
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_REGION=<regiao>
# docker run --rm alpine sh -c 'apk add -q age && age-keygen'
# BACKUP_AGE_PUBLIC_KEY=
# BACKUP_AGE_SECRET_KEY=
