# Template do `.env` no host de staging (copiar para DEPLOY_PATH/.env).
# Nunca reutilize valores de produção — inclusive DATABASE_URL e a caixa de email.

# ---- Imagens (o pipeline injeta IMAGE_TAG e GHCR_IMAGE_PREFIX no deploy) ----
# Preencha no host só se for smoke local; no deploy.yml esses dois vêm do job.
GHCR_IMAGE_PREFIX=ghcr.io/<owner>/orcadom
IMAGE_TAG=v0.0.0
API_PORT=8080
WEB_PORT=3000

# ---- Modo da stack ----
# Self-contained (Postgres + n8n no compose): descomente a linha abaixo
# e use o DATABASE_URL do bloco "deps".
# COMPOSE_PROFILES=deps
#
# Managed Postgres (Neon/RDS/etc.): deixe COMPOSE_PROFILES vazio e use
# o DATABASE_URL do provedor no bloco "managed".

# ---- Postgres (profile deps) ----
POSTGRES_USER=orcadom
POSTGRES_PASSWORD=troque_senha_staging_forte
POSTGRES_DB=orcadom_db
POSTGRES_PORT=5432

# deps (rede interna do compose):
# DATABASE_URL=postgresql://orcadom:troque_senha_staging_forte@postgres:5432/orcadom_db?schema=public
#
# managed (exemplo — troque pelo connection string real da cloud):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/orcadom_staging?schema=public

# ---- Auth (valores próprios de staging) ----
JWT_ACCESS_SECRET=troque_jwt_access_staging
JWT_REFRESH_SECRET=troque_jwt_refresh_staging
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=12h
JWT_REFRESH_REMEMBER_EXPIRATION=30d

# ---- API / Web ----
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
WEB_ORIGIN=https://staging.example.com
API_URL=http://api:8080
NEXT_PUBLIC_API_URL=/backend
REPORTS_DIR=/app/data/reports

# ---- Automação / n8n ----
N8N_PORT=5678
N8N_WEBHOOK_URL=https://staging.example.com/n8n/
AUTOMATION_API_KEY=troque_automation_key_staging
NOTIFICATIONS_WEBHOOK_URL=https://staging.example.com/n8n/webhook/send-notification
NOTIFICATIONS_WEBHOOK_SECRET=troque_notifications_secret_staging

# OBRIGATÓRIO: caixa de teste separada — NÃO use importacoes@orcadom.app
IMPORT_EMAIL_MAILBOX=importacoes+staging@example.com

# ---- Web Push (opcional em staging) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:staging@example.com

# =============================================================================
# GitHub Environment `staging` (Settings → Environments)
# Segredos/variáveis POR environment — nunca compartilhar com production.
#
# Variable:
#   DEPLOY_ENABLED=true          # só depois do host + .env prontos
#   DEPLOY_PATH=/opt/orcadom     # clone do repo no host
#
# Secret:
#   DATABASE_URL                 # mesmo valor do .env do host
#   DEPLOY_HOST                  # hostname/IP SSH
#   DEPLOY_USER                  # usuário SSH
#   DEPLOY_SSH_KEY               # chave privada
#   GHCR_PULL_TOKEN              # PAT com read:packages
# =============================================================================
#
# Seed sintético (no host ou com DATABASE_URL apontando para staging):
#   pnpm db:migrate:deploy
#   pnpm db:seed:staging
#
# Contas do seed: ver docs/29-staging.md (seção Implementação).
