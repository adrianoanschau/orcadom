{
  "name": "orcadom",
  "private": true,
  "version": "0.17.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:split": "./scripts/dev.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @orcadom/e2e test:full",
    "test:e2e:smoke": "pnpm --filter @orcadom/e2e test:smoke",
    "prepare": "husky",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-release-version.mjs",
    "commitlint": "commitlint --edit",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:migrate:deploy": "pnpm --filter @orcadom/database exec prisma migrate deploy",
    "db:seed": "pnpm --filter @orcadom/database db:seed",
    "db:seed:staging": "pnpm --filter @orcadom/database db:seed:staging",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "obs:up": "docker compose --profile observability up -d",
    "obs:down": "docker compose stop grafana prometheus glitchtip glitchtip-worker redis",
    "backup:up": "docker compose --profile backup up -d --build",
    "backup:down": "docker compose stop postgres-backup minio",
    "backup:now": "docker compose --profile backup run --rm postgres-backup /backup/backup.sh",
    "backup:restore-test": "docker compose --profile backup run --rm postgres-backup /backup/restore-test.sh",
    "test:backup": "python3 -m unittest discover -s infra/backup -p 'test_*.py'"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@orcadom/config": "workspace:*",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
