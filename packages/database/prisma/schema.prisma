generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  WALLET
  CHECKING
  CREDIT_CARD
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionSource {
  MANUAL
  IMPORTED
}

enum ImportFormat {
  OFX
  CSV
}

enum ImportStatus {
  PENDING
  UNMAPPED_ACCOUNT
  CONFIRMED
  DISCARDED
}

enum ImportSource {
  MANUAL
  EMAIL
}

enum EmailImportStatus {
  PROCESSED
  SKIPPED_DUPLICATE
  UNRECOGNIZED_TOKEN
  UNMAPPED_ACCOUNT
  ERROR
}

enum PostingStatus {
  SCHEDULED
  POSTED
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum NotificationType {
  BUDGET_WARNING
  BUDGET_EXCEEDED
  EMAIL_IMPORT_READY
  EMAIL_IMPORT_UNMAPPED_ACCOUNT
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts            Account[]
  categories          Category[]
  transactions        Transaction[]
  importBatches       ImportBatch[]
  categoryMemories    CategoryMemory[]
  importAlias         UserImportAlias?
  bankAccountMappings BankAccountMapping[]
  emailImportLogs     EmailImportLog[]
  notifications       Notification[]
  budgets             Budget[]
  installmentPlans       InstallmentPlan[]
  recurringTransactions  RecurringTransaction[]

  @@map("users")
}

model Account {
  id        String      @id @default(uuid())
  name      String
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(12, 2)
  color     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions        Transaction[] @relation("AccountTransactions")
  transfersFrom       Transaction[] @relation("TransferFromAccount")
  transfersTo         Transaction[] @relation("TransferToAccount")
  importBatches       ImportBatch[]
  bankAccountMappings BankAccountMapping[]
  installmentPlans       InstallmentPlan[]
  recurringTransactions  RecurringTransaction[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id    String       @id @default(uuid())
  name  String
  type  CategoryType
  icon  String?
  color String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions     Transaction[]
  categoryMemories CategoryMemory[]
  budgets          Budget[]
  installmentPlans      InstallmentPlan[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, name, type])
  @@index([userId])
  @@map("categories")
}

model Transaction {
  id          String          @id @default(uuid())
  description String
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Usado quando type = INCOME ou EXPENSE
  accountId String?
  account   Account? @relation("AccountTransactions", fields: [accountId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // Usado apenas quando type = TRANSFER
  fromAccountId String?
  fromAccount   Account? @relation("TransferFromAccount", fields: [fromAccountId], references: [id])

  toAccountId String?
  toAccount   Account? @relation("TransferToAccount", fields: [toAccountId], references: [id])

  source        TransactionSource @default(MANUAL)
  externalId    String?
  importBatchId String?
  importBatch   ImportBatch?      @relation(fields: [importBatchId], references: [id])

  postingStatus      PostingStatus    @default(POSTED)
  installmentNumber  Int?
  installmentPlanId  String?
  installmentPlan    InstallmentPlan? @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)

  recurringTransactionId String?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)

  @@unique([accountId, externalId])
  @@unique([recurringTransactionId, date])
  @@index([userId, date])
  @@index([accountId])
  @@index([postingStatus, date])
  @@map("transactions")
}

model InstallmentPlan {
  id                String   @id @default(uuid())
  description       String
  totalAmount       Decimal  @db.Decimal(12, 2)
  installmentsCount Int
  purchaseDate      DateTime
  createdAt         DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  installments Transaction[]

  @@index([userId])
  @@map("installment_plans")
}

model RecurringTransaction {
  id          String              @id @default(uuid())
  description String
  amount      Decimal             @db.Decimal(12, 2)
  type        TransactionType
  frequency   RecurrenceFrequency
  dayOfMonth  Int?
  startDate   DateTime
  endDate     DateTime?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  occurrences Transaction[]

  @@index([userId, active])
  @@map("recurring_transactions")
}

model ImportBatch {
  id            String       @id @default(uuid())
  fileName      String
  format        ImportFormat
  source        ImportSource @default(MANUAL)
  status        ImportStatus @default(PENDING)
  totalRows     Int
  importedRows  Int          @default(0)
  duplicateRows Int          @default(0)
  bankId        String?
  acctId        String?
  preview       Json?
  createdAt     DateTime     @default(now())
  confirmedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  transactions    Transaction[]
  emailImportLogs EmailImportLog[]

  @@index([userId])
  @@index([userId, status])
  @@map("import_batches")
}

model UserImportAlias {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_import_aliases")
}

model BankAccountMapping {
  id     String @id @default(uuid())
  bankId String
  acctId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, bankId, acctId])
  @@index([userId])
  @@map("bank_account_mappings")
}

model EmailImportLog {
  id               String            @id @default(uuid())
  messageId        String
  attachmentHash   String
  recipientAddress String
  status           EmailImportStatus
  errorMessage     String?
  createdAt        DateTime          @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([messageId, attachmentHash])
  @@index([status, createdAt])
  @@map("email_import_logs")
}

model Notification {
  id        String                @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  channels  NotificationChannel[]
  readAt    DateTime?
  createdAt DateTime              @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model Budget {
  id            String    @id @default(uuid())
  amount        Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, categoryId, effectiveFrom])
  @@map("budgets")
}

model CategoryMemory {
  id          String   @id @default(uuid())
  pattern     String
  occurrences Int      @default(1)
  lastUsedAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern, categoryId])
  @@index([userId, pattern])
  @@map("category_memory")
}
