generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  WALLET
  CHECKING
  CREDIT_CARD
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionSource {
  MANUAL
  IMPORTED
}

enum ImportFormat {
  OFX
  CSV
}

enum ImportStatus {
  PENDING
  UNMAPPED_ACCOUNT
  CONFIRMED
  DISCARDED
}

enum ImportSource {
  MANUAL
  EMAIL
}

enum EmailImportStatus {
  PROCESSED
  SKIPPED_DUPLICATE
  UNRECOGNIZED_TOKEN
  UNMAPPED_ACCOUNT
  ERROR
}

enum PostingStatus {
  SCHEDULED
  POSTED
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum NotificationType {
  BUDGET_WARNING
  BUDGET_EXCEEDED
  EMAIL_IMPORT_READY
  EMAIL_IMPORT_UNMAPPED_ACCOUNT
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum HouseholdRole {
  OWNER
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum AuditSource {
  USER
  AUTOMATION_EMAIL
  CRON_INSTALLMENT
  CRON_RECURRING
  SYSTEM
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     HouseholdMember[]
  transactions    Transaction[]
  emailImportLogs EmailImportLog[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Household {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  members               HouseholdMember[]
  invites               HouseholdInvite[]
  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  importBatches         ImportBatch[]
  importAlias           HouseholdImportAlias?
  bankAccountMappings   BankAccountMapping[]
  emailImportLogs       EmailImportLog[]
  budgets               Budget[]
  installmentPlans      InstallmentPlan[]
  recurringTransactions RecurringTransaction[]
  categoryMemories      CategoryMemory[]
  auditLogs             AuditLog[]

  @@map("households")
}

model HouseholdMember {
  id       String        @id @default(uuid())
  role     HouseholdRole @default(MEMBER)
  joinedAt DateTime      @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@index([householdId])
  @@map("household_members")
}

model HouseholdInvite {
  id        String        @id @default(uuid())
  email     String
  token     String        @unique
  role      HouseholdRole @default(MEMBER)
  status    InviteStatus  @default(PENDING)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  invitedByUserId String

  @@index([householdId, status])
  @@index([email, status])
  @@map("household_invites")
}

model Account {
  id        String      @id @default(uuid())
  name      String
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(12, 2)
  color     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  transactions          Transaction[]          @relation("AccountTransactions")
  transfersFrom         Transaction[]          @relation("TransferFromAccount")
  transfersTo           Transaction[]          @relation("TransferToAccount")
  importBatches         ImportBatch[]
  bankAccountMappings   BankAccountMapping[]
  installmentPlans      InstallmentPlan[]
  recurringTransactions RecurringTransaction[]

  @@index([householdId])
  @@map("accounts")
}

model Category {
  id    String       @id @default(uuid())
  name  String
  type  CategoryType
  icon  String?
  color String?

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  transactions          Transaction[]
  categoryMemories      CategoryMemory[]
  budgets               Budget[]
  installmentPlans      InstallmentPlan[]
  recurringTransactions RecurringTransaction[]

  @@unique([householdId, name, type])
  @@index([householdId])
  @@map("categories")
}

model Transaction {
  id          String          @id @default(uuid())
  description String
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation("AccountTransactions", fields: [accountId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  fromAccountId String?
  fromAccount   Account? @relation("TransferFromAccount", fields: [fromAccountId], references: [id])

  toAccountId String?
  toAccount   Account? @relation("TransferToAccount", fields: [toAccountId], references: [id])

  source        TransactionSource @default(MANUAL)
  externalId    String?
  importBatchId String?
  importBatch   ImportBatch?      @relation(fields: [importBatchId], references: [id])

  postingStatus          PostingStatus         @default(POSTED)
  installmentNumber      Int?
  installmentPlanId      String?
  installmentPlan        InstallmentPlan?      @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)
  recurringTransactionId String?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)

  @@unique([accountId, externalId])
  @@unique([recurringTransactionId, date])
  @@index([householdId, date])
  @@index([userId, date])
  @@index([accountId])
  @@index([postingStatus, date])
  @@map("transactions")
}

model InstallmentPlan {
  id                String   @id @default(uuid())
  description       String
  totalAmount       Decimal  @db.Decimal(12, 2)
  installmentsCount Int
  purchaseDate      DateTime
  createdAt         DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  installments Transaction[]

  @@index([householdId])
  @@map("installment_plans")
}

model RecurringTransaction {
  id          String              @id @default(uuid())
  description String
  amount      Decimal             @db.Decimal(12, 2)
  type        TransactionType
  frequency   RecurrenceFrequency
  dayOfMonth  Int?
  startDate   DateTime
  endDate     DateTime?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  occurrences Transaction[]

  @@index([householdId, active])
  @@map("recurring_transactions")
}

model ImportBatch {
  id            String       @id @default(uuid())
  fileName      String
  format        ImportFormat
  source        ImportSource @default(MANUAL)
  status        ImportStatus @default(PENDING)
  totalRows     Int
  importedRows  Int          @default(0)
  duplicateRows Int          @default(0)
  bankId        String?
  acctId        String?
  preview       Json?
  createdAt     DateTime     @default(now())
  confirmedAt   DateTime?

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  transactions    Transaction[]
  emailImportLogs EmailImportLog[]

  @@index([householdId])
  @@index([householdId, status])
  @@map("import_batches")
}

model HouseholdImportAlias {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())

  householdId String    @unique
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("household_import_aliases")
}

model BankAccountMapping {
  id     String @id @default(uuid())
  bankId String
  acctId String

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([householdId, bankId, acctId])
  @@index([householdId])
  @@map("bank_account_mappings")
}

model EmailImportLog {
  id               String            @id @default(uuid())
  messageId        String
  attachmentHash   String
  recipientAddress String
  status           EmailImportStatus
  errorMessage     String?
  createdAt        DateTime          @default(now())

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([messageId, attachmentHash])
  @@index([householdId, createdAt])
  @@index([status, createdAt])
  @@map("email_import_logs")
}

model Notification {
  id        String                @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  channels  NotificationChannel[]
  readAt    DateTime?
  createdAt DateTime              @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model Budget {
  id            String    @id @default(uuid())
  amount        Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([householdId, categoryId, effectiveFrom])
  @@map("budgets")
}

model CategoryMemory {
  id          String   @id @default(uuid())
  pattern     String
  occurrences Int      @default(1)
  lastUsedAt  DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, pattern, categoryId])
  @@index([householdId, pattern])
  @@map("category_memory")
}

model AuditLog {
  id         String      @id @default(uuid())
  entityType String
  entityId   String
  action     AuditAction
  source     AuditSource
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime    @default(now())

  actorUserId String?
  actorUser   User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@index([householdId, entityType, entityId])
  @@index([householdId, createdAt])
  @@map("audit_logs")
}
